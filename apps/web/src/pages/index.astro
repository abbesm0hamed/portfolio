---
import Layout from "@/layouts/main.astro"
import Hero from "@/sections/home/hero/index.astro"
import Work from "@/sections/home/work/index.astro"
import Quote from "@/sections/home/quote/index.astro"
import GHHeatmap from "@/sections/home/gh-heatmap/index.astro"
import Setup from "@/sections/home/setup/index.astro"
import Writings from "@/sections/home/writings/index.astro"
---

<Layout>
  <div
    id="main-scroll"
    class="h-full flex flex-col overflow-hidden max-layout:overflow-y-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
  >
    <div class="layout:h-[30%] grid grid-cols-[7fr_3fr] max-md:grid-cols-1">
      <Hero />
    </div>

    <div class="layout:h-[45%] grid grid-cols-[1fr_3fr] max-layout:grid-cols-1 max-layout:flex-none">
      <div class="grid grid-rows-[20%_80%] max-layout:grid-rows-1 overflow-hidden">
        <GHHeatmap />
        <Quote />
      </div>
      <Work />
    </div>

    <div class="layout:h-[25%] grid grid-cols-[1fr_1fr] max-layout:grid-cols-1 max-layout:flex-none">
      <Writings />
      <Setup />
    </div>
  </div>
</Layout>

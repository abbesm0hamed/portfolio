---
import { getContributions } from "@/lib/github-contributions"

const contributions = await getContributions()
const sorted = contributions.toSorted((a, b) =>
  a.date.localeCompare(b.date)
)
const levelMap = new Map<string, number>(
  sorted.map((a) => [a.date, a.level])
)

const weeks: number[][] = []

if (sorted.length > 0) {
  const firstDate = new Date(sorted[0].date)
  const startDate = new Date(firstDate)
  startDate.setDate(firstDate.getDate() - firstDate.getDay())

  const lastIdx = sorted.length - 1
  const lastDate = new Date(sorted[lastIdx].date)
  lastDate.setDate(lastDate.getDate() + (6 - lastDate.getDay()))

  const endTime = lastDate.getTime()
  const current = new Date(startDate)
  let currentWeek: number[] = []

  while (current.getTime() <= endTime) {
    const dateStr = current.toISOString().slice(0, 10)
    currentWeek.push(levelMap.get(dateStr) ?? 0)

    if (currentWeek.length === 7) {
      weeks.push(currentWeek)
      currentWeek = []
    }

    current.setDate(current.getDate() + 1)
  }
}

const LEVEL_FILLS = [
  "fill-muted",
  "fill-muted-foreground/20",
  "fill-muted-foreground/40",
  "fill-muted-foreground/60",
  "fill-muted-foreground/80",
]

const levelFill = (level: number) => LEVEL_FILLS[level] ?? "fill-muted"
---

<div class="h-full w-full layout:border-r border-b overflow-hidden bg-elevated dark:bg-elevated">
  {weeks.length > 0 && (
    <svg
      class="size-full"
      viewBox={`0 0 ${weeks.length} 7`}
      preserveAspectRatio="none"
    >
      {weeks.map((week, wi) =>
        week.map(
          (level, di) =>
            level > 0 && (
              <rect
                key={`${wi}-${di}`}
                x={wi}
                y={di}
                width={1}
                height={1}
                class={levelFill(level)}
              />
            )
        )
      )}
    </svg>
  )}
</div>
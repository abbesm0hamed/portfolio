---
import SocialBar from "@/components/social-bar.astro"
import ResumeButton from "@/components/resume-button.astro"
import { Badge } from "@workspace/ui/components/badge"
import { Icons } from "@workspace/ui/icons"
---

<div class="layout:border-r border-b flex flex-col justify-between overflow-hidden min-h-0">
  <div class="flex-1 flex flex-col justify-center p-6">
    <span class="text-[clamp(1.25rem,4vw,1.5rem)] font-bold tracking-[0.15em] leading-none">Mohamed Abbes</span>
    <span class="text-[0.8125rem] tracking-[0.2em] uppercase text-muted-foreground mt-2 font-semibold">Code Composer!</span>
    <Badge variant="outline" class="mt-2 gap-1.5 px-2.5 font-semibold tracking-[0.05em]">
      FOCUS: make <Icons.EffectTs aria-hidden="true" /> Effect TS the default
    </Badge>
    <p class="text-[1.1rem] text-muted-foreground leading-relaxed mt-2">
      Software engineer with a background in embedded systems. I build across the stack and care about the details — from how something feels to how it runs.
    </p>
  </div>
  <div class="h-control border-t border-t-border shrink-0 flex">
    <SocialBar />
    <div class="flex-1 bg-grain h-full" />
    <ResumeButton />
  </div>
</div>

<div class="w-full p-2 border-b bg-surface overflow-hidden min-h-0 max-layout:min-h-[18rem] max-layout:max-h-[25rem] max-layout:aspect-[16/10] layout:h-full layout:min-h-0 layout:aspect-auto">
  <img src="/images/me/young_me.png" alt="Young Mohamed at a computer" class="size-full object-cover" />
</div>
